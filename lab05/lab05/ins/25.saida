MOVE(TEMP 1, CONST 0)
MOVE(TEMP 2, MEM(BINOP(PLUS, FP, CONST 8)))
MOVE(TEMP 2, BINOP(MUL, TEMP 2, MEM(BINOP(PLUS, FP, CONST 24))))
MOVE(TEMP 1, BINOP(PLUS, TEMP 1, CONST 1))
LABEL L0
CJUMP(BINOP(LT, TEMP 1, MEM(BINOP(PLUS, FP, CONST 16))), L1, L2)
LABEL L1
MOVE(TEMP 2, BINOP(MUL, TEMP 2, MEM(BINOP(PLUS, FP, CONST 24))))
MOVE(TEMP 1, BINOP(PLUS, TEMP 1, CONST 1))
JUMP(NAME L0)
LABEL L2
