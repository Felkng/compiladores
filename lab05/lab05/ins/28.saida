MOVE(MEM(BINOP(PLUS, FP, CONST -40)), CONST 0)
CJUMP(BINOP(LE, MEM(BINOP(PLUS, FP, CONST 8)), CONST 0), L0, L1)
LABEL L0
MOVE(TEMP 0, CONST 0)
LABEL L1
CJUMP(BINOP(GT, MEM(BINOP(PLUS, FP, CONST 16)), MEM(BINOP(PLUS, FP, CONST 24))), L2, L3)
LABEL L2
MOVE(MEM(BINOP(PLUS, FP, CONST -40)), BINOP(MINUS, MEM(BINOP(PLUS, FP, CONST 16)), MEM(BINOP(PLUS, FP, CONST 24))))
JUMP(NAME L4)
LABEL L3
MOVE(MEM(BINOP(PLUS, FP, CONST -40)), BINOP(MINUS, MEM(BINOP(PLUS, FP, CONST 24)), MEM(BINOP(PLUS, FP, CONST 16))))
LABEL L4
LABEL L5
CJUMP(BINOP(GT, MEM(BINOP(PLUS, FP, CONST 8)), CONST 0), L6, L7)
LABEL L6
MOVE(MEM(BINOP(PLUS, FP, CONST -40)), BINOP(PLUS, MEM(BINOP(PLUS, FP, CONST -40)), MEM(BINOP(PLUS, FP, CONST 8))))
MOVE(MEM(BINOP(PLUS, FP, CONST 8)), BINOP(MINUS, MEM(BINOP(PLUS, FP, CONST 8)), CONST 1))
JUMP(NAME L5)
LABEL L7
MOVE(MEM(BINOP(PLUS, FP, CONST 8)), CONST 0)
LABEL L8
CJUMP(BINOP(LT, MEM(BINOP(PLUS, FP, CONST 8)), CONST 3), L9, L10)
LABEL L9
MOVE(MEM(BINOP(PLUS, FP, CONST -40)), BINOP(PLUS, MEM(BINOP(PLUS, FP, CONST -40)), MEM(BINOP(PLUS, FP, CONST 8))))
MOVE(MEM(BINOP(PLUS, FP, CONST 8)), BINOP(PLUS, MEM(BINOP(PLUS, FP, CONST 8)), CONST 1))
JUMP(NAME L8)
LABEL L10
CJUMP(BINOP(GT, MEM(BINOP(PLUS, FP, CONST -40)), CONST 10), L11, L12)
LABEL L11
MOVE(TEMP 0, CALL(NAME F50, BINOP(DIV, MEM(BINOP(PLUS, FP, CONST -40)), CONST 3), MEM(BINOP(PLUS, FP, CONST 16)), MEM(BINOP(PLUS, FP, CONST 24))))
LABEL L12
MOVE(TEMP 0, MEM(BINOP(PLUS, FP, CONST -40)))
